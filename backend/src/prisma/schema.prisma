datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique(map: "User_email_key")
  password            String
  role                String           @default("TEAM") // ADMIN, MANAGER, C_LEVEL, LEADER, TEAM
  department          String?
  position            String?
  teamId              String?          @map("team_id")
  team                Team?            @relation("TeamMembers", fields: [teamId], references: [id], map: "User_teamId_fkey")
  leadingTeams        Team[]           @relation("TeamLeader")
  assignments         KrAssignment[]
  taskAssignments     TaskAssignment[]
  managedDepartments  Department[]     @relation("DepartmentManager")
  ownedInitiatives    Initiative[]     @relation("InitiativeOwner")
  assignedInitiatives Initiative[]     @relation("InitiativeLeader") // NOTE: FK to user currently missing in DB
  assignedTasks       Task[]           @relation("TaskAssignedMember") // NOTE: FK to user currently missing in DB
  notifications       Notification[]                                  // NOTE: FK to user currently missing in DB
  createdCrossDeptTasks Task[]         @relation("CrossDeptTaskCreator")
  taskComments        TaskComment[]
  auditLogs           AuditLog[]       @relation("UserAuditLogs")
  sprintProgress      MemberSprintProgress[]
  createdAt           DateTime         @default(now()) @map("created_at")

  @@index([teamId], map: "User_teamId_idx")
  @@map("user")
}

model Team {
  id          String       @id @default(uuid())
  name        String
  managerId   String?      @map("manager_id")
  leaderId    String?      @map("leader_id")
  leader      User?        @relation("TeamLeader", fields: [leaderId], references: [id], map: "Team_leaderId_fkey")
  department  String?
  users       User[]       @relation("TeamMembers")
  initiatives Initiative[]

  @@index([leaderId], map: "Team_leaderId_idx")
  @@map("team")
}

model Objective {
  id               String            @id @default(uuid())
  title            String
  description      String?           @db.Text
  quarter          String?
  year             String            @default("Q3-2026")
  ownerId          String?           @map("owner_id")
  keyResults       KeyResult[]
  annualKeyResults AnnualKeyResult[]
  createdAt        DateTime          @default(now()) @map("created_at")

  @@map("objective")
}

model AnnualKeyResult {
  id             String      @id @default(uuid())
  objectiveId    String      @map("objective_id")
  objective      Objective   @relation(fields: [objectiveId], references: [id], map: "AnnualKeyResult_objectiveId_fkey")
  title          String
  description    String?
  targetValue    Float       @map("target_value")
  currentValue   Float       @default(0) @map("current_value")
  unit           String
  bscPerspective String      @map("bsc_perspective")
  year           String
  status         String      @default("ON_TRACK")
  keyResults     KeyResult[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([objectiveId], map: "AnnualKeyResult_objectiveId_fkey")
  @@map("annual_key_result")
}

model KeyResult {
  id                String           @id @default(uuid())
  objectiveId       String           @map("objective_id")
  objective         Objective        @relation(fields: [objectiveId], references: [id], map: "KeyResult_objectiveId_fkey")
  annualKeyResultId String?          @map("annual_key_result_id")
  annualKeyResult   AnnualKeyResult? @relation(fields: [annualKeyResultId], references: [id], map: "KeyResult_annualKeyResultId_fkey")
  month             String?
  monthWeight       Float            @default(1.0) @map("month_weight")
  title             String
  targetValue       Float            @map("target_value")
  currentValue      Float            @default(0) @map("current_value")
  unit              String
  bscPerspective    String           @map("bsc_perspective")
  status            String           @default("ON_TRACK")
  isManualOverride  Boolean          @default(false) @map("is_manual_override")
  assignments       KrAssignment[]
  departments       KrDepartment[]
  updates           KrUpdate[]
  initiatives       Initiative[]
  sprintTargets     KrSprintTarget[]
  sourceLinksA      CausalLink[]     @relation("SourceKR")
  sourceLinksB      CausalLink[]     @relation("TargetKR")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([annualKeyResultId], map: "KeyResult_annualKeyResultId_fkey")
  @@index([objectiveId], map: "KeyResult_objectiveId_idx")
  @@map("key_result")
}

model KrAssignment {
  id          String    @id @default(uuid())
  keyResultId String    @map("key_result_id")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], map: "KrAssignment_keyResultId_fkey")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], map: "KrAssignment_userId_fkey")
  assignedBy  String    @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  raciRole    String    @default("RESPONSIBLE") @map("raci_role")

  @@unique([keyResultId, userId], map: "KrAssignment_keyResultId_userId_key")
  @@index([keyResultId], map: "KrAssignment_keyResultId_idx")
  @@index([userId], map: "KrAssignment_userId_idx")
  @@map("kr_assignment")
}

model KrDepartment {
  id          String    @id @default(uuid())
  keyResultId String    @map("key_result_id")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], map: "KrDepartment_keyResultId_fkey")
  department  String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([keyResultId, department], map: "KrDepartment_keyResultId_department_key")
  @@index([keyResultId], map: "KrDepartment_keyResultId_idx")
  @@map("kr_department")
}

model KrUpdate {
  id          String    @id @default(uuid())
  keyResultId String    @map("key_result_id")
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], map: "KrUpdate_keyResultId_fkey")
  oldValue    Float     @map("old_value")
  newValue    Float     @map("new_value")
  note        String?   @db.Text
  updatedBy   String    @map("updated_by")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@index([keyResultId, updatedAt], map: "KrUpdate_keyResultId_updatedAt_idx")
  @@map("kr_update")
}

model CausalLink {
  id           String    @id @default(uuid())
  sourceKrId   String    @map("source_kr_id")
  sourceKr     KeyResult @relation("SourceKR", fields: [sourceKrId], references: [id], map: "CausalLink_sourceKrId_fkey")
  targetKrId   String    @map("target_kr_id")
  targetKr     KeyResult @relation("TargetKR", fields: [targetKrId], references: [id], map: "CausalLink_targetKrId_fkey")
  relationship String
  note         String?   @db.Text
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([sourceKrId], map: "CausalLink_sourceKrId_idx")
  @@index([targetKrId], map: "CausalLink_targetKrId_idx")
  @@map("causal_link")
}

model Initiative {
  id                String             @id @default(uuid())
  keyResultId       String?            @map("key_result_id")
  keyResult         KeyResult?         @relation(fields: [keyResultId], references: [id], map: "Initiative_keyResultId_fkey")
  teamId            String             @map("team_id")
  team              Team               @relation(fields: [teamId], references: [id], map: "Initiative_teamId_fkey")
  ownerId           String?            @map("owner_id")
  owner             User?              @relation("InitiativeOwner", fields: [ownerId], references: [id], map: "Initiative_ownerId_fkey")
  assignedLeaderId  String?            @map("assigned_leader_id")
  assignedLeader    User?              @relation("InitiativeLeader", fields: [assignedLeaderId], references: [id]) // NOTE: FK missing in DB
  assignedBy        String?            @map("assigned_by")
  title             String
  description       String?            @db.Text
  targetValue       Float              @default(0) @map("target_value")
  currentValue      Float              @default(0) @map("current_value")
  achievedValue     Float?             @map("achieved_value")
  unit              String?
  status            String             @default("ON_TRACK")
  kanbanStatus      String             @default("TODO") @map("kanban_status")
  weight            Float              @default(1.0)
  startDate         DateTime?          @map("start_date")
  dueDate           DateTime?          @map("due_date")
  finishDate        DateTime?          @map("finish_date")
  sprintMonth       String?            @map("sprint_month")
  sprintId          String?            @map("sprint_id")
  sprint            Sprint?            @relation(fields: [sprintId], references: [id])
  documentationLink String?            @map("documentation_link")
  tasks             Task[]
  kpis              InitiativeKpi[]                                    // NOTE: FK missing in DB
  progressUpdates   InitiativeUpdate[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([sprintId], map: "Initiative_sprintId_idx")
  @@index([sprintMonth], map: "Initiative_sprintMonth_idx")
  @@index([assignedLeaderId], map: "Initiative_assignedLeaderId_idx")
  @@index([keyResultId], map: "Initiative_keyResultId_idx")
  @@index([ownerId], map: "Initiative_ownerId_idx")
  @@index([teamId], map: "Initiative_teamId_idx")
  @@map("initiative")
}

model Task {
  id                   String           @id @default(uuid())
  initiativeId         String?          @map("initiative_id")
  initiative           Initiative?      @relation(fields: [initiativeId], references: [id], map: "Kpi_initiativeId_fkey")
  assignedTeamMemberId String?          @map("assigned_team_member_id")
  assignedTeamMember   User?            @relation("TaskAssignedMember", fields: [assignedTeamMemberId], references: [id]) // NOTE: FK missing in DB
  assignedBy           String?          @map("assigned_by")
  sprintMonth          String?          @map("sprint_month")
  sprintId             String?          @map("sprint_id")
  sprint               Sprint?          @relation(fields: [sprintId], references: [id])
  startDate            DateTime?        @map("start_date")
  finishDate           DateTime?        @map("finish_date")
  title                String
  targetValue          Float?           @default(0) @map("target_value")
  currentValue         Float            @default(0) @map("current_value")
  baselineValue        Float            @default(0) @map("baseline_value")
  weight               Float            @default(1.0)
  unit                 String?
  status               String           @default("ON_TRACK")
  kanbanStatus         String?          @default("TODO") @map("kanban_status")
  documentationLink    String?          @map("documentation_link")
  isCrossDept          Boolean          @default(false) @map("is_cross_dept")
  creatorId            String?          @map("creator_id")
  creator              User?            @relation("CrossDeptTaskCreator", fields: [creatorId], references: [id])
  creatorDept          String?          @map("creator_dept")
  targetDept           String?          @map("target_dept")
  description          String?          @db.Text
  link                 String?
  assignments          TaskAssignment[]
  updates              TaskUpdate[]
  kpis                 TaskKpi[]                                          // NOTE: FK missing in DB
  comments             TaskComment[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([initiativeId], map: "Kpi_initiativeId_idx")
  @@index([assignedTeamMemberId], map: "Task_assignedTeamMemberId_idx")
  @@index([creatorId], map: "Task_creatorId_idx")
  @@index([targetDept], map: "Task_targetDept_idx")
  @@index([sprintMonth], map: "Task_sprintMonth_idx")
  @@index([sprintId], map: "Task_sprintId_idx")
  @@map("task")
}

model TaskComment {
  id             String   @id @default(uuid())
  taskId         String   @map("task_id")
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  message        String   @db.Text
  attachmentLink String?  @map("attachment_link")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([userId])
  @@map("task_comment")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], map: "KpiAssignment_kpiId_fkey")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], map: "KpiAssignment_userId_fkey")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([taskId, userId], map: "TaskAssignment_taskId_userId_key")
  @@index([taskId], map: "TaskAssignment_taskId_idx")
  @@index([userId], map: "KpiAssignment_userId_idx")
  @@map("task_assignment")
}

model TaskUpdate {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  task        Task      @relation(fields: [taskId], references: [id], map: "KpiUpdate_kpiId_fkey")
  oldValue    Float     @map("old_value")
  newValue    Float     @map("new_value")
  note        String?   @db.Text
  link        String?
  submittedBy String    @map("submitted_by")
  status      String    @default("PENDING_APPROVAL")
  reviewedBy  String?   @map("reviewed_by")
  reviewNote  String?   @db.Text @map("review_note")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([taskId, createdAt], map: "TaskUpdate_taskId_createdAt_idx")
  @@map("task_update")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  value     String   @unique(map: "Department_value_key")
  isActive  Boolean  @default(true) @map("is_active")
  managerId String?  @map("manager_id")
  manager   User?    @relation("DepartmentManager", fields: [managerId], references: [id], map: "Department_managerId_fkey")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([managerId], map: "Department_managerId_fkey")
  @@map("department")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], map: "AuditLog_userId_fkey")
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@map("audit_log")
}

model InitiativeUpdate {
  id           String     @id @default(uuid())
  initiativeId String     @map("initiative_id")
  initiative   Initiative @relation(fields: [initiativeId], references: [id], map: "InitiativeUpdate_initiativeId_fkey")
  oldValue     Float      @map("old_value")
  newValue     Float      @map("new_value")
  note         String?    @db.Text
  kanbanStatus String?    @map("kanban_status")
  link         String?
  submittedBy  String     @map("submitted_by")
  status       String     @default("PENDING_APPROVAL")
  reviewedBy   String?    @map("reviewed_by")
  reviewedAt   DateTime?  @map("reviewed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([initiativeId, createdAt], map: "InitiativeUpdate_initiativeId_createdAt_idx")
  @@map("initiative_update")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  recipient   User     @relation(fields: [recipientId], references: [id]) // NOTE: FK missing in DB
  type        String   @db.VarChar(100)
  title       String   @db.VarChar(255)
  body        String   @db.Text
  link        String?  @db.VarChar(500)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([recipientId, isRead], map: "Notification_recipientId_isRead_idx")
  @@index([recipientId, createdAt], map: "Notification_recipientId_createdAt_idx")
  @@map("notification")
}

model Kpi {
  id             String          @id @default(uuid())
  name           String
  description    String?         @db.Text
  department     String?
  bscPerspective String          @map("bsc_perspective")
  unit           String
  defaultTarget  Float?          @map("default_target")
  status         String          @default("ACTIVE")
  initiativeKpis InitiativeKpi[] // NOTE: FK missing in DB
  taskKpis       TaskKpi[]       // NOTE: FK missing in DB
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([bscPerspective], map: "Kpi_bscPerspective_idx")
  @@index([department], map: "Kpi_department_idx")
  @@map("kpi")
}

model InitiativeKpi {
  id           String     @id @default(uuid())
  initiativeId String     @map("initiative_id")
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade) // NOTE: FK missing in DB, cascade not enforced
  kpiId        String     @map("kpi_id")
  kpi          Kpi        @relation(fields: [kpiId], references: [id]) // NOTE: FK missing in DB
  targetValue  Float      @map("target_value")
  currentValue Float      @default(0) @map("current_value")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([initiativeId, kpiId], map: "InitiativeKpi_initiativeId_kpiId_key")
  @@index([initiativeId], map: "InitiativeKpi_initiativeId_idx")
  @@index([kpiId], map: "InitiativeKpi_kpiId_idx")
  @@map("initiative_kpi")
}

model TaskKpi {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade) // NOTE: FK missing in DB, cascade not enforced
  kpiId        String   @map("kpi_id")
  kpi          Kpi      @relation(fields: [kpiId], references: [id]) // NOTE: FK missing in DB
  targetValue  Float    @map("target_value")
  currentValue Float    @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([taskId, kpiId], map: "TaskKpi_taskId_kpiId_key")
  @@index([taskId], map: "TaskKpi_taskId_idx")
  @@index([kpiId], map: "TaskKpi_kpiId_idx")
  @@map("task_kpi")
}

model Sprint {
  id            String                 @id @default(uuid())
  name          String
  startDate     DateTime               @map("start_date")
  endDate       DateTime               @map("end_date")
  status        String                 @default("UPCOMING") // UPCOMING, ACTIVE, CLOSED
  isLocked      Boolean                @default(false) @map("is_locked")
  year          String                 @default("2026")
  orderIndex    Int                    @default(1) @map("order_index")
  initiatives   Initiative[]
  tasks         Task[]
  krTargets     KrSprintTarget[]
  memberScores  MemberSprintProgress[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([status], map: "Sprint_status_idx")
  @@index([startDate, endDate], map: "Sprint_startDate_endDate_idx")
  @@map("sprint")
}

model KrSprintTarget {
  id              String    @id @default(uuid())
  keyResultId     String    @map("key_result_id")
  keyResult       KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  sprintId        String    @map("sprint_id")
  sprint          Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  baselineValue   Float     @default(0) @map("baseline_value")
  targetValue     Float     @default(0) @map("target_value")
  currentValue    Float     @default(0) @map("current_value")
  aggregationType String    @default("SUM") @map("aggregation_type") // SUM, AVERAGE, LAST_VALUE
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([keyResultId, sprintId], map: "KrSprintTarget_keyResultId_sprintId_key")
  @@index([sprintId], map: "KrSprintTarget_sprintId_idx")
  @@map("kr_sprint_target")
}

model MemberSprintProgress {
  id             String   @id @default(uuid())
  sprintId       String   @map("sprint_id")
  sprint         Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore     Float    @map("total_score") // Capaian 0 - 100%
  taskCount      Int      @default(0) @map("task_count")
  completedCount Int      @default(0) @map("completed_count")
  detailsJson    Json?    @map("details_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([sprintId, userId], map: "MemberSprintProgress_sprintId_userId_key")
  @@index([userId], map: "MemberSprintProgress_userId_idx")
  @@map("member_sprint_progress")
}
